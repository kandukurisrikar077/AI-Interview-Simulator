# ==============================================================================
# IntervueAI — Environment Variable Template
# Copy this file to '.env' and populate with your secure secrets.
# NEVER commit real production credentials to Git!
# ==============================================================================

# Core Application Settings
PROJECT_NAME="IntervueAI"
ENVIRONMENT="development"  # Use "production" for live deployments

# Security & JWT Configuration
# In production, SECRET_KEY MUST be a unique, cryptographically random string (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace_with_cryptographically_secure_random_string_min_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Database Configuration - Standardized on PostgreSQL
# Local development PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intervue_db"
# Production Managed PostgreSQL connection:
# DATABASE_URL="postgresql://user:password@host:5432/database"

# Code Execution Sandbox Settings
CODE_SANDBOX_TIMEOUT_SECONDS="3.0"
CODE_SANDBOX_MAX_CODE_CHARS="10000"

# AI / LLM Engine Settings
AI_PROVIDER="gemini"  # "gemini" or "openai"
GEMINI_API_KEY="your_gemini_api_key_from_google_ai_studio"
OPENAI_API_KEY="your_openai_api_key_if_using_openai_fallback"
OPENAI_MODEL="gpt-4o-mini"

# SMTP Email Configuration (for verification OTPs)
# In development, leave blank or "mock" for simulated console OTP dispatch
# In production, all 5 SMTP fields are required for live email dispatch
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your_smtp_username_here"
SMTP_PASSWORD="your_smtp_password_here"
SMTP_FROM_EMAIL="noreply@intervue.ai"
